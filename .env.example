# Postgres — create a free db at https://neon.tech and paste the pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/workflowos?sslmode=require"
# Direct (non-pooled) URL for migrations — Neon shows both
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/workflowos?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Required only when the seed creates the initial owner account
OWNER_PASSWORD="replace-with-a-strong-password"

# Phase 3 placeholders (leave blank for now)
# ── QuickBooks Online (developer.intuit.com → create app → Keys) ──
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENV="sandbox"            # "production" after Intuit app review
# ── Gmail (console.cloud.google.com → OAuth client, Web app) ──
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ── FedEx (developer.fedex.com → create project → Ship + Rate APIs) ──
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_ACCOUNT_NUMBER=""
FEDEX_ENV="sandbox"          # "production" once your project is approved
ANTHROPIC_API_KEY=""
